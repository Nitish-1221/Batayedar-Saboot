<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Application Theme with High Contrast Agricultural Green Palette -->
    <style name="Theme.Bataydar" parent="Theme.Material3.Light">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorPrimaryVariant">@color/primary_green_dark</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorSecondary">@color/primary_green</item>
        <item name="colorOnSecondary">@color/text_on_primary</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/input_border</item>
        <item name="colorError">@color/error_text</item>
        <item name="colorOnError">@color/white</item>

        <!-- System & Window -->
        <item name="android:windowBackground">@color/bg_screen</item>
        <item name="android:statusBarColor">@color/primary_green_dark</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Global Text Colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/input_hint</item>
        <item name="editTextColor">@color/edit_text_color_selector</item>
        <item name="android:editTextColor">@color/edit_text_color_selector</item>

        <!-- Action Bar Customization -->
        <item name="actionBarStyle">@style/Widget.Bataydar.ActionBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.Bataydar.ActionBar</item>

        <!-- Default Component Styles -->
        <item name="textInputStyle">@style/Widget.Bataydar.TextInputLayout</item>
        <item name="editTextStyle">@style/Widget.Bataydar.TextInputEditText</item>
        <item name="chipStyle">@style/Widget.Bataydar.Chip</item>
        <item name="materialButtonStyle">@style/Widget.Bataydar.Button.Primary</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Bataydar.Button.Outlined</item>
    </style>

    <!-- Theme for Activities without Native Action Bar -->
    <style name="Theme.Bataydar.NoActionBar" parent="Theme.Material3.Light.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorPrimaryVariant">@color/primary_green_dark</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorSecondary">@color/primary_green</item>
        <item name="colorOnSecondary">@color/text_on_primary</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/input_border</item>
        <item name="colorError">@color/error_text</item>
        <item name="colorOnError">@color/white</item>

        <!-- System & Window -->
        <item name="android:windowBackground">@color/bg_screen</item>
        <item name="android:statusBarColor">@color/primary_green_dark</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Global Text Colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/input_hint</item>
        <item name="editTextColor">@color/edit_text_color_selector</item>
        <item name="android:editTextColor">@color/edit_text_color_selector</item>

        <!-- Default Component Styles -->
        <item name="textInputStyle">@style/Widget.Bataydar.TextInputLayout</item>
        <item name="editTextStyle">@style/Widget.Bataydar.TextInputEditText</item>
        <item name="chipStyle">@style/Widget.Bataydar.Chip</item>
        <item name="materialButtonStyle">@style/Widget.Bataydar.Button.Primary</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Bataydar.Button.Outlined</item>
    </style>

    <!-- Toolbar / Action Bar Style -->
    <style name="Widget.Bataydar.ActionBar" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">@color/primary_green</item>
        <item name="android:background">@color/primary_green</item>
        <item name="titleTextStyle">@style/TextAppearance.Bataydar.ActionBar.Title</item>
        <item name="subtitleTextStyle">@style/TextAppearance.Bataydar.ActionBar.Subtitle</item>
    </style>

    <style name="TextAppearance.Bataydar.ActionBar.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.Bataydar.ActionBar.Subtitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">@color/primary_green_light</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="ThemeOverlay.Bataydar.ActionBar" parent="ThemeOverlay.Material3.ActionBar">
        <item name="colorControlNormal">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/primary_green_light</item>
    </style>

    <!-- Centralized High-Contrast TextInputLayout Style -->
    <style name="Widget.Bataydar.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/box_stroke_selector</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/primary_green</item>
        <item name="android:textColorHint">@color/hint_color_selector</item>
        <item name="placeholderTextColor">@color/input_hint</item>
        <item name="boxBackgroundColor">@color/input_bg</item>
        <item name="helperTextTextColor">@color/text_secondary</item>
        <item name="errorTextColor">@color/error_text</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
    </style>

    <!-- Centralized High-Contrast TextInputEditText Style -->
    <style name="Widget.Bataydar.TextInputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/edit_text_color_selector</item>
        <item name="android:textColorHint">@color/input_hint</item>
        <item name="android:textColorHighlight">@color/primary_green_container</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>

    <!-- Centralized High-Contrast Crop Selector Chip Style -->
    <style name="TextAppearance.Bataydar.Chip" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/chip_text_selector</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Bataydar.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background_selector</item>
        <item name="android:textColor">@color/chip_text_selector</item>
        <item name="android:textAppearance">@style/TextAppearance.Bataydar.Chip</item>
        <item name="chipStrokeColor">@color/chip_stroke_selector</item>
        <item name="chipStrokeWidth">1.5dp</item>
        <item name="chipCornerRadius">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <!-- Centralized Primary Button Style -->
    <style name="Widget.Bataydar.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/button_bg_selector</item>
        <item name="android:textColor">@color/button_text_selector</item>
        <item name="iconTint">@color/button_text_selector</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">50dp</item>
    </style>

    <!-- Centralized Outlined Button Style -->
    <style name="Widget.Bataydar.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/primary_green</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/primary_green</item>
        <item name="iconTint">@color/primary_green</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">50dp</item>
    </style>
</resources>
