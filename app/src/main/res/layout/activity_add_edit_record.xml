<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Independent Record Notice Banner -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/success_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/primary_green"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/primary_green_dark" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/independent_record_notice"
                    android:textColor="@color/primary_green_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Farmer Information Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvRecordIdLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary_green_dark"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="New Cultivation Record" />

                <TextView
                    android:id="@+id/tvFarmerIdHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Farmer: Rameshwar (ID: FMR-20261028-4B2E) • Bilsi" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Field Identifier -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFieldName"
            style="@style/Widget.Bataydar.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/field_name_label"
            app:placeholderText="@string/field_name_hint"
            app:placeholderTextColor="@color/input_hint"
            app:helperText="@string/field_name_helper"
            app:helperTextTextColor="@color/text_secondary"
            app:helperTextEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFieldName"
                style="@style/Widget.Bataydar.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:textColor="@color/edit_text_color_selector"
                android:textColorHint="@color/input_hint"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Crop Type -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCropType"
            style="@style/Widget.Bataydar.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:hint="@string/crop_type_label"
            app:placeholderText="@string/crop_type_hint"
            app:placeholderTextColor="@color/input_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCropType"
                style="@style/Widget.Bataydar.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:textColor="@color/edit_text_color_selector"
                android:textColorHint="@color/input_hint"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Quick Crop Selector Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutCropChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPaddy"
                    style="@style/Widget.Bataydar.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:checkable="true"
                    android:textColor="@color/chip_text_selector"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1.5dp"
                    app:checkedIconVisible="false"
                    android:text="@string/crop_paddy" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWheat"
                    style="@style/Widget.Bataydar.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:checkable="true"
                    android:textColor="@color/chip_text_selector"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1.5dp"
                    app:checkedIconVisible="false"
                    android:text="@string/crop_wheat" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMustard"
                    style="@style/Widget.Bataydar.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:checkable="true"
                    android:textColor="@color/chip_text_selector"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1.5dp"
                    app:checkedIconVisible="false"
                    android:text="@string/crop_mustard" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSugarcane"
                    style="@style/Widget.Bataydar.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:checkable="true"
                    android:textColor="@color/chip_text_selector"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1.5dp"
                    app:checkedIconVisible="false"
                    android:text="@string/crop_sugarcane" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMaize"
                    style="@style/Widget.Bataydar.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:checkable="true"
                    android:textColor="@color/chip_text_selector"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1.5dp"
                    app:checkedIconVisible="false"
                    android:text="@string/crop_maize" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipVegetables"
                    style="@style/Widget.Bataydar.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:textColor="@color/chip_text_selector"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1.5dp"
                    app:checkedIconVisible="false"
                    android:text="@string/crop_vegetables" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Sowing Date -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSowingDate"
            style="@style/Widget.Bataydar.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/sowing_date_label"
            app:placeholderText="@string/sowing_date_hint"
            app:placeholderTextColor="@color/input_hint"
            app:endIconDrawable="@drawable/ic_calendar"
            app:endIconMode="custom"
            app:endIconTint="@color/primary_green">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSowingDate"
                style="@style/Widget.Bataydar.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:cursorVisible="false"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none"
                android:textColor="@color/edit_text_color_selector"
                android:textColorHint="@color/input_hint"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Optional Field Description / Notes -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFieldDesc"
            style="@style/Widget.Bataydar.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:hint="@string/field_desc_label"
            app:placeholderText="@string/field_desc_hint"
            app:placeholderTextColor="@color/input_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFieldDesc"
                style="@style/Widget.Bataydar.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:textColor="@color/edit_text_color_selector"
                android:textColorHint="@color/input_hint"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Optional Landlord Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/primary_green_subtle"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/landlord_section_optional_title"
                    android:textColor="@color/primary_green_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/landlord_section_optional_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilLandlordName"
                    style="@style/Widget.Bataydar.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/landlord_name_label"
                    app:placeholderText="@string/landlord_name_hint"
                    app:placeholderTextColor="@color/input_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLandlordName"
                        style="@style/Widget.Bataydar.TextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:textColor="@color/edit_text_color_selector"
                        android:textColorHint="@color/input_hint"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilLandlordPhone"
                    style="@style/Widget.Bataydar.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/landlord_phone_label"
                    app:placeholderText="@string/landlord_phone_hint"
                    app:placeholderTextColor="@color/input_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLandlordPhone"
                        style="@style/Widget.Bataydar.TextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:maxLength="10"
                        android:textColor="@color/edit_text_color_selector"
                        android:textColorHint="@color/input_hint"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbRequestConfirmation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/landlord_cb_request_confirmation"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    app:buttonTint="@color/primary_green" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Prominent Button: Save & Capture GPS Evidence -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveAndCapture"
            style="@style/Widget.Bataydar.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_save_and_capture"
            android:textColor="@color/text_on_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_camera"
            app:iconGravity="textStart"
            app:iconTint="@color/text_on_primary" />

        <!-- Secondary Button: Save Draft Only -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveDraft"
            style="@style/Widget.Bataydar.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="@string/btn_save_draft"
            android:textColor="@color/primary_green"
            android:textSize="15sp"
            app:cornerRadius="12dp"
            app:strokeColor="@color/primary_green" />

    </LinearLayout>
</ScrollView>
