    <!-- Welcome / Onboarding -->
    <string name="welcome_title">बटाईदार सबूत में आपका स्वागत है</string>
    <string name="welcome_body">सरकारी भूमि रिकॉर्ड (खतौनी/खसरा) में केवल ज़मींदार का नाम होता है। यह ऐप आपको—बटाईदार किसान को—सत्यापित जीपीएस फोटो के ज़रिए अपनी बोई और सींची गई फसलों का स्वतंत्र दस्तावेज़ीकरण करने में सक्षम बनाता है।</string>
    <string name="feature_1_title">100% ऑफ़लाइन और स्वतंत्र</string>
    <string name="feature_1_desc">बिना इंटरनेट के दूरदराज के खेतों में काम करता है। जीपीएस सीधे उपग्रहों से जुड़ता है।</string>
    <string name="feature_2_title">अनिवार्य जीपीएस जियोटैगिंग</string>
    <string name="feature_2_desc">हर फसल फोटो में डिवाइस द्वारा सत्यापित जीपीएस निर्देशांक (&lt; 20 मीटर सटीकता) और समय दर्ज होता है।</string>
    <string name="feature_3_title">कानूनी साक्ष्य डोज़ियर</string>
    <string name="feature_3_desc">ज़रूरत पड़ने पर फोटो साक्ष्य के साथ प्रमाणित पीडीएफ और ज़िप बंडल निर्यात करें।</string>
