    <!-- Welcome / Onboarding -->
    <string name="welcome_title">Welcome to Batayedar Saboot</string>
    <string name="welcome_body">Official land records (Khatauni / Khasra) show only the landowner\'s name. This app empowers you—the tenant farmer (Bataidar)—to independently record and document the crops you sow and nurture using verifiable GPS-geotagged photographs.</string>
    <string name="feature_1_title">100% Offline &amp; Independent</string>
    <string name="feature_1_desc">Works in remote fields without internet connection. GPS satellites connect directly to your device.</string>
    <string name="feature_2_title">Mandatory GPS Geotagging</string>
    <string name="feature_2_desc">Every crop photo is locked with device-verified GPS coordinates (&lt; 20m accuracy) and timestamps.</string>
    <string name="feature_3_title">Legal Evidence Dossier</string>
    <string name="feature_3_desc">Export tamper-evident PDF dossiers and full ZIP bundles with photographic proof whenever needed.</string>
    <string name="btn_get_started">Get Started</string>
    <string name="btn_already_registered">Continue to My Farm</string>

