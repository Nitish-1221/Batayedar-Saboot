<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="true" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".BataydarApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Bataydar">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.Bataydar.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.welcome.WelcomeActivity"
            android:exported="false"
            android:theme="@style/Theme.Bataydar.NoActionBar" />

        <activity
            android:name=".ui.landlord.LandlordAuthActivity"
            android:exported="false"
            android:theme="@style/Theme.Bataydar.NoActionBar" />

        <activity
            android:name=".ui.landlord.LandlordDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.Bataydar.NoActionBar" />

        <activity
            android:name=".ui.landlord.LandlordReviewActivity"
            android:exported="false"
            android:theme="@style/Theme.Bataydar.NoActionBar" />
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.Bataydar.NoActionBar" />
        <activity
            android:name=".ui.profile.ProfileEditActivity"
            android:exported="false"
            android:theme="@style/Theme.Bataydar" />
        <activity
            android:name=".ui.records.AddEditRecordActivity"
            android:exported="false"
            android:theme="@style/Theme.Bataydar" />
        <activity
            android:name=".ui.capture.GpsCaptureActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Bataydar.NoActionBar" />
        <activity
            android:name=".ui.capture.EvidencePreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.Bataydar" />
        <activity
            android:name=".ui.detail.RecordDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Bataydar" />
        <activity
            android:name=".ui.landlord.LandlordConfirmationActivity"
            android:exported="false"
            android:theme="@style/Theme.Bataydar" />
        <activity
            android:name=".ui.export.ExportDossierActivity"
            android:exported="false"
            android:theme="@style/Theme.Bataydar" />
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Bataydar" />
    </application>

</manifest>