# ==============================================================================
# Batayedar Saboot — Backend Environment Configuration Example
# ==============================================================================
# Copy this file to .env and configure values before starting the application.
# NEVER commit real production secrets or credentials to source control.
# ==============================================================================

# Server Network Settings
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# MongoDB Connection String (e.g. mongodb://localhost:27017/batayedar_saboot or Atlas URI)
MONGODB_URI=mongodb://localhost:27017/batayedar_saboot

# JWT Security Secrets (Use long, cryptographically random strings in production)
# Example generation: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_super_secret_high_entropy_access_key_min_64_chars
JWT_REFRESH_SECRET=replace_with_a_super_secret_high_entropy_refresh_key_min_64_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=batayedar-saboot-auth
JWT_AUDIENCE=batayedar-saboot-client

# CORS Allowed Origins (Comma-separated list of origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5000,https://batayedar-saboot.onrender.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# Object Storage Configuration (AWS S3 or S3-compatible provider e.g. MinIO, Cloudflare R2)
# When STORAGE_PROVIDER=local, uploads are stored locally in the backend data directory for offline/dev testing.
STORAGE_PROVIDER=local
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=batayedar-evidence-vault-private
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
PRESIGNED_URL_EXPIRES_SECONDS=900

# File Upload Limits
MAX_FILE_SIZE_BYTES=15728640
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Logging
LOG_LEVEL=info
